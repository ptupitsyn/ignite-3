<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>Apache.Ignite.snk</AssemblyOriginatorKeyFile>

        <!-- Major (8) matches EF Core major version, minor and patch match Ignite version -->
        <Version>8.3.2</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" PrivateAssets="none" Version="8.0.17" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" PrivateAssets="none" Version="8.0.17" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" PrivateAssets="none" Version="8.0.17" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="none" Version="8.0.17" />
        <PackageReference Include="Microsoft.Extensions.DependencyModel" PrivateAssets="none" Version="8.0.2" />

        <PackageReference Include="JetBrains.Annotations" Version="2023.3.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Extensions\Internal\" />
      <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Apache.Ignite\Apache.Ignite.csproj" />
    </ItemGroup>

</Project>
